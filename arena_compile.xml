<mujoco model="arena">
  <compiler angle="radian"/>

  <option integrator="implicitfast"/>

  <visual>
    <headlight ambient="0.3 0.3 0.3" diffuse="0.6 0.6 0.6"/>
  </visual>

  <asset>
    <texture type="2d" colorspace="auto" name="grid" builtin="checker" mark="edge" rgb1="0.1 0.2 0.3" rgb2="0.2 0.3 0.4" markrgb="0.2 0.3 0.4" width="300" height="300"/>
    <material name="grid" texture="grid" texrepeat="2 2" texuniform="true" reflectance="0.2"/>
  </asset>

  <worldbody>
    <geom size="5 5 0.1" type="plane"/>
    <geom name="floor" size="2 2 0.1" pos="0 0 -0.5" type="plane" solref="0.001" solimp="0.99 0.99 0.01" material="grid"/>
    <light pos="0 0 3"/>
    <light pos="0 0 1" mode="trackcom"/>
    <body name="chassis" pos="0 0 0.05">
      <joint type="free"/>
      <geom size="0.15 0.1 0.03" type="box" mass="1"/>
      <geom size="0.05" pos="-0.12 0 0" condim="1" priority="1" mass="0.05"/>
      <body name="roue_g" pos="0.05 0.12 0">
        <joint name="g" axis="0 1 0"/>
        <geom size="0.05 0.01" quat="0.707107 0.707107 0 0" type="cylinder"/>
      </body>
      <body name="roue_d" pos="0.05 -0.12 0">
        <joint name="d" axis="0 1 0"/>
        <geom size="0.05 0.01" quat="0.707107 0.707107 0 0" type="cylinder"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <general joint="g" ctrlrange="-10 10" forcerange="-0.2 0.2" input="vel" biastype="affine" biasprm="0 0 -1"/>
    <general joint="d" ctrlrange="-10 10" forcerange="-0.2 0.2" input="vel" biastype="affine" biasprm="0 0 -1"/>
  </actuator>
</mujoco>
